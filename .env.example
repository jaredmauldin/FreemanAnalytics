NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Project Settings → API → service_role (secret). Must NOT be the anon public key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt

# Clerk — https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Webhook signing secret (Clerk Dashboard → Webhooks → your endpoint → Signing Secret).
# Required for POST /api/webhooks/clerk so new users get publicMetadata.appAccess set.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# New sign-ups: default approved app access when user.created webhook runs.
# Set to "false" to set appAccess to "pending" until an admin approves on /admin/users.
# AUTO_APPROVE_SIGNUPS=true

# Roles: assign admins in Clerk → Users → user → Metadata → Public:
#   { "role": "admin" }   (string is matched case-insensitively: "Admin" works too.)
# Optional: comma-separated Clerk user IDs that always count as admin (use your user id from Clerk
# dashboard if metadata is not applied yet): CLERK_ADMIN_USER_IDS=user_2abc...,user_2def...
# (omit "role" or use any value other than "admin" for standard users.)
# Also enable Email/Password (or your providers) and "Sign up" in Clerk → User & Authentication.

# Optional (defaults match /sign-in and /sign-up in this app):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
