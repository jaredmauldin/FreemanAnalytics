NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Project Settings → API → service_role (secret). Must NOT be the anon public key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt

# Clerk — https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional (defaults match /sign-in and /sign-up in this app):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
